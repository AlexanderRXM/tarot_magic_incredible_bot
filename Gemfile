source "https://rubygems.org"

ruby "3.4.2" # (или версия, которую ты используешь)

# Основной клиент для Telegram
gem "telegram-bot-ruby", "~> 0.22.0"

# Работа с базой данных (SQLite)
gem "sqlite3", "~> 1.7"

# ORM — чтобы просто работать с таблицами
gem "activerecord", "~> 7.1"

# Планировщик задач (для карты дня по расписанию)
gem "rufus-scheduler", "~> 3.9"

# Для отладки и логирования
gem "pry"
gem "logger"

# Для автозагрузки dotenv-файла с токеном
gem "dotenv", "~> 3.1"
gem "httparty"
gem "pg"
gem "sequel"